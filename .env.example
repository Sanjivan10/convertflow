# ---------------------------------------------------------------------------
# Copy to `.env` for local dev. On Vercel, set these in
# Project → Settings → Environment Variables (Postgres + Blob are auto-added
# when you create them from the Storage tab).
# ---------------------------------------------------------------------------

# Hosted Postgres connection string.
#  - Vercel Postgres / Neon / Supabase all give you one.
#  - Vercel injects this automatically after you add a Postgres store.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth signing secret. Generate one: `npx auth secret`  (or any long random string)
AUTH_SECRET="replace-with-a-long-random-string"

# The site's public URL. Used for canonical tags, OpenGraph, sitemap.
NEXT_PUBLIC_SITE_URL="https://tools.example.com"

# Vercel Blob write token — auto-added by Vercel when you create a Blob store.
# Leave blank locally: uploads then save to /public/uploads instead.
BLOB_READ_WRITE_TOKEN=""

# Google AdSense publisher id, e.g. ca-pub-XXXXXXXXXXXXXXXX. Optional.
NEXT_PUBLIC_ADSENSE_CLIENT=""

# --- Document conversion (Word/PowerPoint/Excel -> PDF, PDF -> PowerPoint,
#     PDF/A, and URL -> PDF). Leave blank to keep those tools in "setup" mode. ---
#
# Pick ONE provider:
#   "convertapi"   - https://www.convertapi.com  (set CONVERSION_API_KEY = your Secret)
#   "cloudmersive" - https://cloudmersive.com    (set CONVERSION_API_KEY = your API key)
#   "gotenberg"    - self-hosted https://gotenberg.dev (set CONVERSION_SERVICE_URL,
#                    e.g. https://gotenberg.yourdomain.com — no API key needed)
CONVERSION_PROVIDER=""
CONVERSION_API_KEY=""
CONVERSION_SERVICE_URL=""
# Max upload size (MB) and per-request timeout (ms) for server conversions.
CONVERSION_MAX_MB="25"
CONVERSION_TIMEOUT_MS="90000"

# Seed admin account (used by `npm run db:seed`)
SEED_ADMIN_EMAIL="team.idea2grow@gmail.com"
SEED_ADMIN_PASSWORD="Sanjivan"
SEED_ADMIN_NAME="Idea2Grow"
